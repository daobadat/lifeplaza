<script>
//<![CDATA[
function showDanhBa(json) {
  const entries = json.feed.entry || [];
  let html = "";

  entries.forEach(e => {
	console.log(e)
    let postUrl = "";
    let imgSrc = "";
    let title = e.title?.$t || "Xem chi tiết";

    // 1. Lấy permalink chính xác (ưu tiên rel="alternate")
    if (e.link && e.link.length) {
      const altLink = e.link.find(l => l.rel === "alternate" && l.type === "text/html");
      if (altLink) postUrl = altLink.href;
    }

    // 2. Lấy ảnh đầu tiên trong nội dung
    if (e.content && e.content.$t) {
      const div = document.createElement("div");
      div.innerHTML = e.content.$t;

      const img = div.querySelector("img");
      imgSrc = img ? img.src : "";
    }

    // 3. Nếu có ảnh + có link thì render card
    if (imgSrc && postUrl) {
      html += `
        <div class="company-card">
          <a href="${postUrl}" target="_blank" rel="noopener noreferrer" title="${title}">
            <img src="${imgSrc}" alt="${title}" loading="lazy" />
          </a>
        </div>
      `;
    }
  });

  document.getElementById("list").innerHTML += html;
}
//]]>
</script>

