<script>
document.addEventListener(&quot;DOMContentLoaded&quot;, () =&gt; {
  const tabs = document.querySelectorAll(&quot;.info-tabs button&quot;);
  const sliderTrack = document.querySelector(&quot;.slider-track&quot;);

  tabs.forEach(tab =&gt; {
    tab.addEventListener(&quot;click&quot;, () =&gt; {
      // toggle nút active
      tabs.forEach(t =&gt; t.classList.remove(&quot;active&quot;));
      tab.classList.add(&quot;active&quot;);

      // dịch slide
      const index = parseInt(tab.getAttribute(&quot;data-tab&quot;), 10);
      sliderTrack.style.transform = `translateX(-${index * 100}%)`;
    });
  });
});
</script>


    
    
<script>
//<![CDATA[
function showRecommended(json) {
  const entries = json.feed.entry || [];
  let html = "";

  entries.forEach(e => {
    const content = e.content?.$t || "";
    const div = document.createElement("div");
    div.innerHTML = content;

    const ps = [...div.querySelectorAll("p")]
      .map(p => p.textContent.trim())
      .filter(t => t);

    const company = {
      name: ps[0] || "Chưa có tên",
      phone: ps[1] || "",
      address: ps[2] || ""
    };

    html += `
      <div class="recommended-card">
        <div class="recommended-top">
          <span class="recommended-name">${company.name}</span>
          <span class="recommended-phone">${company.phone}</span>
        </div>
        <div class="recommended-address">${company.address}</div>
      </div>
    `;
  });

  document.getElementById("recommended-list").innerHTML = html;
}
//]]>
</script>	

<script>
//<![CDATA[
document.write('<script src=\"/feeds/posts/default/-/DANHBA?alt=json-in-script&callback=showRecommended\"><\/script>');
//]]>
</script> 
  </body>
</html>